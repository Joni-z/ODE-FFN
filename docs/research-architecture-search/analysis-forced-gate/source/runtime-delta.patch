+        torch.testing.assert_close(jacobians[0], jacobians[1], atol=0, rtol=0)
+        torch.testing.assert_close(jacobians[0]@jacobians[0].T,
+                                   jacobians[1]@jacobians[1].T, atol=0, rtol=0)
