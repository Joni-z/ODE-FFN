+            for order in (1, 2, 3):
+                expected = (rates[:, None]*left)@torch.linalg.matrix_power(compressed, order-1)@right
+                torch.testing.assert_close(torch.linalg.matrix_power(generator, order), expected, atol=2e-16, rtol=3e-14)
+            for scale in (-.3, .2):
